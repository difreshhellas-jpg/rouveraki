#####################################################################
# Rouveraki — copy to .env.local and fill in.  NEVER commit .env*    #
#####################################################################

# ---- site ---------------------------------------------------------
# Used in SMS links, OG tags and the Viva return URL. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- database (Supabase Postgres) ---------------------------------
# DATABASE_URL  -> the pooled connection (port 6543), used at runtime
# DIRECT_URL    -> the direct connection (port 5432), used by migrations
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ---- Supabase (auth + realtime) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Bootstrap allowlist for the admin panel, comma separated. Once staff have a
# role in app_metadata (see supabase/policies.sql) this can be emptied.
ADMIN_EMAILS=""

# ---- payments -----------------------------------------------------
# THE switch. "mock" (default) never calls Viva: payments auto-confirm with a
# fake reference, while still building and validating the real fiscal receipt
# data. "live" uses Viva Smart Checkout + Fiscalisation for Online Sales.
# Nothing else changes between the two.
PAYMENT_MODE="mock"

# ---- Viva.com (only needed when PAYMENT_MODE=live) -----------------
# "demo" until the sandbox flow is fully tested; then "production".
VIVA_ENVIRONMENT="demo"
VIVA_CLIENT_ID=""
VIVA_CLIENT_SECRET=""
# Optional: shown in the Viva dashboard against each transaction.
VIVA_SOURCE_CODE=""

# The key Viva fetches from GET /api/webhooks/viva to activate the webhook.
VIVA_WEBHOOK_VERIFICATION_KEY=""
# Optional extra gate: if set, the webhook rejects requests without this value
# in the x-rouveraki-webhook-token header. Defence in depth only — the real
# check is the transaction lookup against Viva's API.
VIVA_WEBHOOK_PATH_TOKEN=""

# Shared secret for HMAC-SHA256 verification of incoming webhook bodies.
# Without it the webhook still re-reads every transaction from Viva before
# trusting it, but set this too.
VIVA_WEBHOOK_SECRET=""

# Numeric payment-method ids from the Viva dashboard. Leave empty to show every
# method enabled on the account. See the note in src/lib/viva.ts.
VIVA_PAYMENT_METHOD_ID_CARD=""
VIVA_PAYMENT_METHOD_ID_IRIS=""

# Refuses to boot live while Viva Fiscalisation is still a stub (Part 2).
# Set to "true" only deliberately, on the accountant's say-so.
ALLOW_LIVE_WITHOUT_FISCALISATION=""

# ---- SMS ----------------------------------------------------------
# "log" (default, prints to console), "twilio" or "yuboto".
SMS_PROVIDER="log"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
YUBOTO_API_KEY=""
YUBOTO_SENDER="Rouveraki"

# ---- contact form -------------------------------------------------
CONTACT_FORWARD_TO=""
CONTACT_FROM="Rouveraki <noreply@rouveraki.gr>"
RESEND_API_KEY=""

# ---- local test mode ----------------------------------------------------
# Opens /admin with no login and fakes card/IRIS payments, so the whole app can
# be exercised without a Viva account or a Supabase project.
# LOCAL DEVELOPMENT ONLY — the server refuses to boot if this is set in a
# production build. Leave both empty for any real deployment.
DEV_BYPASS=""
NEXT_PUBLIC_DEV_BYPASS=""
